# --- Deployment (Vercel + Supabase) ------------------------------------
# Unset locally: everything runs on the SQLite file as before. Set these on
# the deployment only.
#
# Supabase Postgres. Use the TRANSACTION POOLER (port 6543), not the direct
# 5432 connection - serverless opens many short-lived connections.
DATABASE_URL=
# Stable cookie-signing key. Without it each cold start invalidates every
# session and two instances reject each other's cookies.
SESSION_SECRET=
# Let anyone with the link browse and try the demo without the password.
# Destructive and real-telephony routes stay gated either way
# (server/auth.py:PROTECTED_ALWAYS).
PUBLIC_DEMO=false
# Schema is created once by scripts/migrate_to_postgres.py, not per request.
SKIP_DB_INIT=false

# Login for the dashboard/admin API (server/auth.py, server/routes/login.py).
# If left unset, a random password is generated at startup and printed to the
# console - fine for a local demo, but pin these before putting
# PUBLIC_BASE_URL behind a public tunnel.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Vapi drives outbound calling. VAPI_PRIVATE_KEY is set by hand,
# VAPI_ASSISTANT_ID is written by `python -m server.vapi_setup setup`.
VAPI_PRIVATE_KEY=
VAPI_ASSISTANT_ID=
# The Vapi-hosted number to dial *from*, bought/imported in the Vapi
# dashboard - `python -m server.vapi_setup numbers` prints the ids.
VAPI_PHONE_NUMBER_ID=

# a1mobile handles inbound calls and SMS only; outbound goes through Vapi.
A1MOBILE_BASE_URL=https://hack.a1mobile.com
A1MOBILE_TEAM_KEY=team-c478af96
A1MOBILE_PHONE_NUMBER=+14108011742

# Public URL for this server (ngrok URL while developing). No trailing slash.
PUBLIC_BASE_URL=

# Set to true only when actually placing/receiving a live call and you want
# real SMS sent through a1mobile. Defaults to false so the demo loop stays
# simulated.
A1MOBILE_LIVE_SMS=false


OPENAI_API_KEY=
OPENAI_BASE_URL=

# Direct OpenAI key for the realtime speech-to-speech voice agent
OPENAI_REALTIME_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

DB_PATH=./data/settlewise.db
SEED_PATH=./data/seed.json
MAX_DISCOUNT_PCT=15
