# --- Deployment (Vercel + Supabase) ------------------------------------
# Leave DATABASE_URL blank locally and everything runs on the SQLite file.
# Paste the Supabase TRANSACTION POOLER string (port 6543, not the direct
# 5432) to run against Postgres, and to run scripts/migrate_to_postgres.py.
DATABASE_URL=
# Stable cookie-signing key. Set the same value on Vercel; without it each
# cold start invalidates every session.
SESSION_SECRET=
# Login guarding the destructive routes (Reset DB, delete). Blank password
# locally = one is generated and printed at startup. Pin both on Vercel.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# On Vercel set all three: PUBLIC_DEMO=true so visitors can browse without
# the password, SKIP_DB_INIT=true because the migration script creates the
# schema once, ENABLE_VOICE=false because the voice stack is left out of
# the bundle (no live calls on the public link).
PUBLIC_DEMO=false
SKIP_DB_INIT=false
ENABLE_VOICE=

# --- Local ---------------------------------------------------------------
DB_PATH=./data/settlewise.db
SEED_PATH=./data/seed.json
MAX_DISCOUNT_PCT=15
# Public URL for this server (ngrok while developing). No trailing slash.
PUBLIC_BASE_URL=

# --- Vapi (outbound calling) ---------------------------------------------
# VAPI_PRIVATE_KEY is set by hand; VAPI_ASSISTANT_ID is written by
# `python -m server.vapi_setup setup`; `... numbers` prints the number ids.
VAPI_PRIVATE_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_MODEL=gpt-4.1

# --- SMS -----------------------------------------------------------------
# No provider is wired (server/sms_client.py). Texts are always recorded;
# they are only sent when this is true AND a provider is implemented.
LIVE_SMS=false

# --- OpenAI --------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Direct key for the realtime speech-to-speech agent.
OPENAI_REALTIME_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Further optional tunables (repayment %, call window, demo clock, post-call
# model) have defaults in server/config.py.
