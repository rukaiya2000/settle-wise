# a1mobile (hackathon telephony API)
A1MOBILE_BASE_URL=https://hack.a1mobile.com
A1MOBILE_TEAM_KEY=team-c478af96
A1MOBILE_PHONE_NUMBER=+14108011742

# Public URL for this server (ngrok URL while developing). No trailing slash.
PUBLIC_BASE_URL=

# Set to true only when actually placing/receiving a live call and you want
# real SMS sent through a1mobile. Defaults to false so the demo loop stays
# simulated per md/product-brief.md and md/mvp-scope.md non-goals.
A1MOBILE_LIVE_SMS=false

# Hackathon AI gateway (HTTP-only /responses endpoint - not used by the voice
# agent, which needs a real WebSocket connection; kept for anything else)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Direct OpenAI key for the realtime speech-to-speech voice agent
OPENAI_REALTIME_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

DB_PATH=./data/settlewise.db
SEED_PATH=./data/seed.json
MAX_DISCOUNT_PCT=15
